{
  "manifest_version": 3,
  "name": "TTS Screen Reader",
  "description": "Screenshot → OCR → Read aloud. Reads scanned PDFs and images that Narrator can't.",
  "version": "2.1",
  "key": "",
  "permissions": ["activeTab", "sidePanel", "nativeMessaging"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:5912/*"],
  "action": {
    "default_title": "TTS Screen Reader",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
